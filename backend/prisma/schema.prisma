// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════════════════════
//  ENUMS
//  All status/category/type fields must be enums — no raw strings for domain values.
// ═══════════════════════════════════════════════════════════════════════════════

enum Role {
  student
  faculty
  hod
  admin
  finance_officer
  librarian
  management
  examiner
  analytics
}

enum FeeStatus {
  paid
  partial
  due
}

enum AttendanceStatus {
  present
  absent
}

enum ExamStatus {
  upcoming
  ongoing
  completed
  evaluated
}

enum FeeQuota {
  general
  merit
  management
  nri
}

enum PaymentMethod {
  UPI
  NetBanking
  CreditCard
  DebitCard
  Challan
  DemandDraft
}

enum TransactionStatus {
  success
  pending
  failed
  refunded
}

enum CirculationStatus {
  issued
  returned
  overdue
}

enum FineStatus {
  unpaid
  paid
  waived
}

enum NoticeCategory {
  academic
  examination
  events
  fee
  general
}

enum NoticeTargetRole {
  all
  student
  faculty
  hod
  admin
  finance_officer
  librarian
  management
  analytics
}

// NEW — replaces raw String fields

enum CourseType {
  theory
  lab
  elective
  project
}

enum DayOfWeek {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
}

enum DocumentStatus {
  pending
  processing
  completed
  rejected
}

enum ApplicationStatus {
  pending
  approved
  rejected
  waitlisted
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
}

// ═══════════════════════════════════════════════════════════════════════════════
//  MODELS
// ═══════════════════════════════════════════════════════════════════════════════

// ─── User ────────────────────────────────────────────────────────────────────
// Central identity record. One user has exactly one role-specific profile.

model User {
  id        String   @id @default(uuid())
  campusId  String   @unique
  email     String   @unique
  name      String
  password  String
  role      Role     @default(student)
  phone     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations (back-references)
  studentProfile   Student?
  facultyProfile   Faculty?
  fineRecords      FineRecord[]
  borrowedBooks    CirculationRecord[]
  publishedNotices Notice[]

  // P1.3 Security Relations
  roleAssignments  UserRoleAssignment[]
  credentials      UserCredential[]
  authSessions     AuthSession[]

  // P2 Lifecycle Relations
  employeeProfile         EmployeeProfile?
  canonicalStudentProfile StudentProfile?

  // P3 Relations
  examinerAssignments     ExaminerAssignment[]
  hodAssignments          InstitutionHodAssignment[]
  reviewedDocuments       DocumentRequest[]          @relation("ReviewedDocuments")

  @@index([role])
  @@index([campusId])
}

// ─── Department ───────────────────────────────────────────────────────────────
// headOfDepartmentId is a proper FK to Faculty — NOT a raw string placeholder.
// The circular (Faculty ↔ Department) reference is resolved by naming both sides.

model Department {
  id                 String   @id @default(uuid())
  code               String   @unique
  name               String   @unique // Two departments cannot share a name
  headOfDepartmentId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Proper FK relation to Faculty (named to disambiguate from Faculty.department)
  headOfDepartment Faculty? @relation("DepartmentHOD", fields: [headOfDepartmentId], references: [id], onDelete: SetNull)

  // Back-references
  students       Student[]
  faculty        Faculty[]        @relation("DepartmentFaculty")
  courses        Course[]
  timetables        TimetableEntry[]
  appointments   DepartmentAppointment[]
  expenseRecords ExpenseRecord[]
}

// ─── Student ─────────────────────────────────────────────────────────────────

model Student {
  id                   String    @id @default(uuid())
  userId               String    @unique
  rollNumber           String    @unique
  departmentId         String
  degree               String?
  semester             Int       @default(1)
  batch                String?
  section              String?
  cgpa                 Float?    @default(0.0)
  attendancePercentage Float?    @default(0.0)
  feeStatus            FeeStatus @default(due)
  feeQuota             FeeQuota  @default(general)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  // Back-references
  attendanceRecords AttendanceRecord[]
  examResults       ExamResult[]
  feeTransactions   FeeTransaction[]
  documentRequests  DocumentRequest[]
  placements        PlacementRecord[]

  // Indexes — every FK and frequently-filtered column needs an index
  @@index([departmentId])
  @@index([feeStatus])
  @@index([semester])
  @@index([batch])
  @@index([departmentId, semester, section]) // composite for workload/timetable queries
}

// ─── Faculty ─────────────────────────────────────────────────────────────────

model Faculty {
  id                  String   @id @default(uuid())
  userId              String   @unique
  employeeCode        String   @unique
  departmentId        String
  designation         String
  qualification       String?
  weeklyWorkloadHours Float?   @default(0)
  leaveBalance        Float?   @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation("DepartmentFaculty", fields: [departmentId], references: [id], onDelete: Restrict)

  // Back-references
  courses          Course[]
  timetableEntries TimetableEntry[]
  leaveRequests    LeaveRequest[]
  headOf           Department[]     @relation("DepartmentHOD")

  @@index([departmentId])
  @@index([designation])
}

// ─── Course ───────────────────────────────────────────────────────────────────
// NOTE: facultyInstructor field renamed to facultyId (stores Faculty.id, not a name).
// @map("faculty_instructor") preserves the existing DB column — zero data migration needed.

model Course {
  id           String     @id @default(uuid())
  code         String     @unique
  name         String
  departmentId String
  semester     Int
  credits      Int
  type         CourseType @default(theory) // was String? — now a proper enum
  description  String?
  facultyId    String?    @map("faculty_instructor") // renamed field, same DB column
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  faculty    Faculty?   @relation(fields: [facultyId], references: [id], onDelete: SetNull)

  // Back-references
  attendanceRecords AttendanceRecord[]
  examResults       ExamResult[]
  timetables        TimetableEntry[]
  examinerAssignments ExaminerAssignment[]

  @@index([departmentId])
  @@index([departmentId, semester]) // most common query pattern
  @@index([semester])
}

// ─── AttendanceRecord ────────────────────────────────────────────────────────
// CRITICAL: composite unique prevents duplicate attendance entries.

model AttendanceRecord {
  id        String           @id @default(uuid())
  studentId String
  courseId  String
  date      DateTime
  period    Int
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Prevents marking the same student twice in the same period
  @@unique([studentId, courseId, date, period])
  @@index([studentId])
  @@index([courseId])
  @@index([date])
  @@index([studentId, courseId])
}

// ─── TimetableEntry ──────────────────────────────────────────────────────────
// Three conflict-prevention unique constraints:
//   1. A faculty cannot be in two rooms at the same time.
//   2. A room cannot host two classes at the same time.
//   3. A section of a dept cannot have two classes at the same time.
// departmentId stored directly (denormalized from Course) to enable constraint #3.

model TimetableEntry {
  id           String    @id @default(uuid())
  dayOfWeek    DayOfWeek // was String — now a proper enum
  period       Int
  timeSlot     String
  courseId     String
  facultyId    String
  roomNumber   String
  section      String
  semester     Int
  departmentId String // denormalized from Course.departmentId for constraint
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty    Faculty    @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  // Scheduling conflict guards
  @@unique([dayOfWeek, period, facultyId]) // No faculty double-booking
  @@unique([dayOfWeek, period, roomNumber]) // No room double-booking
  @@unique([dayOfWeek, period, section, semester, departmentId]) // No section double-booking within dept
  @@index([facultyId])
  @@index([courseId])
  @@index([departmentId, section, semester])
}

// ─── Examination ─────────────────────────────────────────────────────────────
// Was completely isolated — ExamResult had NO link back. Fixed with back-reference.

model Examination {
  id                 String     @id @default(uuid())
  title              String
  academicYear       String?
  semester           Int
  startDate          DateTime
  endDate            DateTime
  status             ExamStatus @default(upcoming)
  hallTicketReleased Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  examResults ExamResult[]
  examinerAssignments ExaminerAssignment[]

  @@index([semester])
  @@index([status])
}

// ─── ExamResult ───────────────────────────────────────────────────────────────
// Added examinationId FK (nullable for backward compat with existing rows).
// Composite unique prevents duplicate results per student/course/exam.

model ExamResult {
  id            String   @id @default(uuid())
  studentId     String
  courseId      String
  examinationId String? // nullable — links result to the specific exam
  internalScore Float?
  endSemScore   Float?
  totalScore    Float
  grade         String
  status        String   @default("published")
  submittedBy   String?
  submittedAt   DateTime?
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  examination Examination? @relation(fields: [examinationId], references: [id], onDelete: SetNull)

  // Prevent duplicate results for the same student+course within the same exam
  @@unique([studentId, courseId, examinationId])
  @@index([studentId])
  @@index([courseId])
  @@index([examinationId])
  @@index([status])
}

// ─── FeeStructure ────────────────────────────────────────────────────────────
// Composite unique prevents duplicate structures for same program+quota.

model FeeStructure {
  id             String   @id @default(uuid())
  program        String
  quota          FeeQuota @default(general)
  tuitionFee     Float    @default(0)
  hostelFee      Float    @default(0)
  examFee        Float    @default(0)
  libraryDeposit Float    @default(0)
  totalAmount    Float
  dueDate        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([program, quota]) // One structure per program per quota
  @@index([program])
}

// ─── FeeTransaction ──────────────────────────────────────────────────────────

model FeeTransaction {
  id            String            @id @default(uuid())
  receiptNumber String            @unique
  studentId     String
  amount        Float
  paymentMethod PaymentMethod?
  status        TransactionStatus @default(pending)
  paidAt        DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@index([paidAt])
}

// ─── Book ────────────────────────────────────────────────────────────────────

model Book {
  id              String   @id @default(uuid())
  isbn            String   @unique
  title           String
  author          String
  publisher       String?
  category        String?
  rackLocation    String?
  totalCopies     Int      @default(1)
  availableCopies Int      @default(1)
  coverImageUrl   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  circulationRecords CirculationRecord[]

  @@index([category])
  @@index([author])
}

// ─── CirculationRecord ───────────────────────────────────────────────────────
// onDelete: Restrict on Book — cannot delete a book that has borrow history.
// Added back-reference to FineRecord so fines are traceable to their source borrow.

model CirculationRecord {
  id         String            @id @default(uuid())
  bookId     String
  borrowerId String
  issueDate  DateTime
  dueDate    DateTime
  returnDate DateTime?
  fineAmount Float?            @default(0)
  status     CirculationStatus @default(issued)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  book     Book         @relation(fields: [bookId], references: [id], onDelete: Restrict) // Block book deletion with any borrow history
  borrower User         @relation(fields: [borrowerId], references: [id], onDelete: Restrict) // Block user deletion with borrow history
  fines    FineRecord[] // back-reference — was missing

  @@index([borrowerId])
  @@index([bookId])
  @@index([status])
  @@index([dueDate]) // for overdue detection
  @@index([borrowerId, status])
}

// ─── FineRecord ──────────────────────────────────────────────────────────────
// circulationId added — fines are now traceable to the exact borrow that caused them.

model FineRecord {
  id            String     @id @default(uuid())
  userId        String
  circulationId String? // FK → CirculationRecord.id (nullable for manual fines)
  amount        Float
  reason        String?
  status        FineStatus @default(unpaid)
  issuedAt      DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  circulation CirculationRecord? @relation(fields: [circulationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([circulationId])
}

// ─── Notice ──────────────────────────────────────────────────────────────────

model Notice {
  id          String           @id @default(uuid())
  title       String
  content     String           @db.Text
  category    NoticeCategory   @default(general)
  targetRole  NoticeTargetRole @default(all)
  department  String?
  publishedBy String?
  publishedAt DateTime         @default(now())
  isUrgent    Boolean          @default(false)
  isPinned    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  publisher User? @relation(fields: [publishedBy], references: [id], onDelete: SetNull)

  @@index([targetRole])
  @@index([publishedAt])
  @@index([isUrgent])
  @@index([department])
}

// ─── LeaveRequest ─────────────────────────────────────────────────────────────
// status changed from String to LeaveStatus enum.
// onDelete: Cascade — if faculty is deleted, leave requests go too.

model LeaveRequest {
  id        String      @id @default(uuid())
  facultyId String
  type      String
  fromDate  DateTime
  toDate    DateTime
  days      Int
  reason    String
  status    LeaveStatus @default(pending) // was String — now proper enum
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([facultyId])
  @@index([status])
  @@index([fromDate, toDate])
}

// ─── DocumentRequest ──────────────────────────────────────────────────────────
// status changed from String to DocumentStatus enum.

model DocumentRequest {
  id           String         @id @default(uuid())
  studentId    String
  documentName   String
  purpose        String?
  documentUrl    String?
  reviewerId     String?
  reviewedAt     DateTime?
  rejectionReason String?
  status         DocumentStatus @default(pending) // was String — now proper enum
  requestedAt  DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewer User?   @relation("ReviewedDocuments", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([status])
  @@index([reviewerId])
}

// ─── AdmissionApplication ─────────────────────────────────────────────────────
// status changed from String to ApplicationStatus enum.

model AdmissionApplication {
  id            String            @id @default(uuid())
  applicantName String
  applicationId String            @unique
  program       String
  department    String
  jeeRank       Int?
  gateRank      Int?
  category      String
  quota         String
  status        ApplicationStatus @default(pending) // was String — now proper enum
  appliedDate   DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@index([department])
  @@index([program])

  // P2 Relation (TD-1: Admitted Applications referenced by Program Enrollment)
  programEnrollments StudentProgramEnrollment[]
}

// ─── PlacementRecord ──────────────────────────────────────────────────────────
// Added onDelete: Cascade — was missing (delete student → orphan records).

model PlacementRecord {
  id          String   @id @default(uuid())
  studentId   String
  companyName String
  companyType String
  ctc         Float
  offerDate   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([companyName])
}

// ─── Permission & RolePermission ──────────────────────────────────────────────

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  category    String
  description String
  roles       RolePermission[]

  @@index([category])
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
}

// ─── Phase 4 Analytics Supplements ──────────────────────────────────────────

model SystemActivity {
  id          String   @id @default(uuid())
  action      String
  description String
  type        String   @default("info") // 'success', 'warning', 'info', 'destructive'
  timestamp   DateTime @default(now())

  @@index([timestamp])
}

model ExpenseRecord {
  id           String   @id @default(uuid())
  departmentId String?
  category     String
  amount       Float
  date         DateTime @default(now())
  createdAt    DateTime @default(now())

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([category])
}

model ResearchGrant {
  id          String   @id @default(uuid())
  title       String
  agency      String
  amount      Float
  status      String   @default("active")
  awardedDate DateTime
  createdAt   DateTime @default(now())

  @@index([awardedDate])
}

// ═══════════════════════════════════════════════════════════════════════════════
//  PHASE 1: FOUNDATION SCHEMA & MIGRATION INFRASTRUCTURE (P1.1 & P1.2)
//  Additive-only tables with native UUID primary keys.
//  Existing legacy tables remain completely untouched.
// ═══════════════════════════════════════════════════════════════════════════════

// ─── P1.1: Migration Infrastructure ──────────────────────────────────────────

model IdMap {
  tableName String   @map("table_name")
  oldId     String   @map("old_id")
  newId     String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("new_id")
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")

  @@id([tableName, oldId])
  @@unique([tableName, newId])
  @@index([tableName])
  @@map("_id_map")
}

model TermDateMap {
  academicTermId       String       @db.Uuid @map("academic_term_id")
  legacySemesterNumber Int?         @map("legacy_semester_number")
  entryCohortYear      Int?         @db.SmallInt @map("entry_cohort_year")
  dateRangeStart       DateTime     @db.Date @map("date_range_start")
  dateRangeEnd         DateTime     @db.Date @map("date_range_end")
  confidence           String       @map("confidence")
  notes                String?      @map("notes")
  createdAt            DateTime     @default(now()) @db.Timestamptz @map("created_at")

  academicTerm         AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Restrict)

  @@id([academicTermId, dateRangeStart])
  @@index([legacySemesterNumber, entryCohortYear])
  @@map("_term_date_map")
}

// ─── P1.2: Institutional Hierarchy ───────────────────────────────────────────

model Institution {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  name      String
  legalName String?  @map("legal_name")
  website   String?
  status    String   @default("active")
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz @map("updated_at")

  campuses      Campus[]
  academicYears AcademicYear[]
  programs      Program[]

  // P2 Lifecycle Relations
  employeeProfiles          EmployeeProfile[]
  studentProfiles           StudentProfile[]
  studentProgramEnrollments StudentProgramEnrollment[]
  hodAssignments            InstitutionHodAssignment[]

  @@map("institutions")
}

model Campus {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionId String      @db.Uuid @map("institution_id")
  code          String
  name          String
  address       String?
  timezone      String      @default("Asia/Kolkata")
  status        String      @default("active")
  createdAt     DateTime    @default(now()) @db.Timestamptz @map("created_at")
  updatedAt     DateTime    @default(now()) @updatedAt @db.Timestamptz @map("updated_at")

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  rooms         Room[]
  departmentAppointments DepartmentAppointment[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("campuses")
}

model AcademicYear {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionId String         @db.Uuid @map("institution_id")
  code          String
  name          String
  startDate     DateTime       @db.Date @map("start_date")
  endDate       DateTime       @db.Date @map("end_date")
  isCurrent     Boolean        @default(false) @map("is_current")
  createdAt     DateTime       @default(now()) @db.Timestamptz @map("created_at")
  updatedAt     DateTime       @default(now()) @updatedAt @db.Timestamptz @map("updated_at")

  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  academicTerms AcademicTerm[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([isCurrent])
  @@map("academic_years")
}

model AcademicTerm {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academicYearId String        @db.Uuid @map("academic_year_id")
  code           String
  name           String
  termType       String        @map("term_type")
  startDate      DateTime      @db.Date @map("start_date")
  endDate        DateTime      @db.Date @map("end_date")
  examStartDate  DateTime?     @db.Date @map("exam_start_date")
  examEndDate    DateTime?     @db.Date @map("exam_end_date")
  isCurrent      Boolean       @default(false) @map("is_current")
  createdAt      DateTime      @default(now()) @db.Timestamptz @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamptz @map("updated_at")

  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  termDateMaps   TermDateMap[]
  entryProgramEnrollments StudentProgramEnrollment[]
  termRegistrations       StudentTermRegistration[]

  @@unique([academicYearId, code])
  @@index([academicYearId])
  @@index([isCurrent])
  @@map("academic_terms")
}

model Program {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionId  String      @db.Uuid @map("institution_id")
  code           String
  name           String
  degree         String
  departmentName String?     @map("department_name")
  durationYears  Int         @default(4) @map("duration_years")
  totalSemesters Int         @default(8) @map("total_semesters")
  status         String      @default("active")
  createdAt      DateTime    @default(now()) @db.Timestamptz @map("created_at")
  updatedAt      DateTime    @default(now()) @updatedAt @db.Timestamptz @map("updated_at")

  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  studentProgramEnrollments StudentProgramEnrollment[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([degree])
  @@map("programs")
}

model Room {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campusId   String   @db.Uuid @map("campus_id")
  roomNumber String   @map("room_number")
  building   String?
  floor      Int?
  capacity   Int      @default(60)
  roomType   String   @default("classroom") @map("room_type")
  status     String   @default("active")
  createdAt  DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz @map("updated_at")

  campus     Campus   @relation(fields: [campusId], references: [id], onDelete: Restrict)

  @@unique([campusId, roomNumber])
  @@index([campusId])
  @@map("rooms")
}

// ═══════════════════════════════════════════════════════════════════════════════
//  PHASE 1: IDENTITY & SECURITY FOUNDATION (P1.3)
//  Additive canonical RBAC, decoupled credentials, and stateful sessions.
//  Legacy User.role, Permission, and RolePermission remain active.
// ═══════════════════════════════════════════════════════════════════════════════

model AppRole {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz @map("updated_at")

  rolePermissions     AppRolePermission[]
  userRoleAssignments UserRoleAssignment[]

  @@map("roles")
}

model AppPermission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name        String
  module      String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz @map("updated_at")

  rolePermissions AppRolePermission[]

  @@index([module])
  @@map("permissions")
}

model AppRolePermission {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String        @db.Uuid @map("role_id")
  permissionId String        @db.Uuid @map("permission_id")
  createdAt    DateTime      @default(now()) @db.Timestamptz @map("created_at")

  role         AppRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   AppPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id")
  roleId    String    @db.Uuid @map("role_id")
  isActive  Boolean   @default(true) @map("is_active")
  validFrom DateTime  @default(now()) @db.Timestamptz @map("valid_from")
  validTo   DateTime? @db.Timestamptz @map("valid_to")
  createdAt DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AppRole   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_role_assignments")
}

model UserCredential {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id")
  credentialType      String    @default("password") @map("credential_type")
  passwordHash        String    @map("password_hash")
  algorithm           String    @default("bcrypt")
  passwordChangedAt   DateTime  @default(now()) @db.Timestamptz @map("password_changed_at")
  requiresChange      Boolean   @default(false) @map("requires_change")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @db.Timestamptz @map("locked_until")
  createdAt           DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @db.Timestamptz @map("updated_at")

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, credentialType])
  @@index([userId])
  @@map("user_credentials")
}

model AuthSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id")
  sessionTokenHash String    @unique @map("session_token_hash")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  isActive         Boolean   @default(true) @map("is_active")
  expiresAt        DateTime  @db.Timestamptz @map("expires_at")
  lastActivityAt   DateTime  @default(now()) @db.Timestamptz @map("last_activity_at")
  revokedAt        DateTime? @db.Timestamptz @map("revoked_at")
  revocationReason String?   @map("revocation_reason")
  createdAt        DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz @map("updated_at")

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionTokenHash])
  @@index([expiresAt])
  @@index([userId, isActive])
  @@map("auth_sessions")
}

// ═══════════════════════════════════════════════════════════════════════════════
//  PHASE 2: STUDENT & FACULTY LIFECYCLE (P2.1 - P2.4)
//  Additive canonical employee, faculty, student identity, enrollment, and progression.
// ═══════════════════════════════════════════════════════════════════════════════

model EmployeeProfile {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @unique @map("user_id")
  institutionId         String    @db.Uuid @map("institution_id")
  employeeNumber        String    @map("employee_number")
  firstName             String    @map("first_name")
  lastName              String    @map("last_name")
  employmentType        String    @default("permanent") @map("employment_type")
  employmentStatus      String    @default("active") @map("employment_status")
  joinedOn              DateTime  @default(now()) @db.Date @map("joined_on")
  exitedOn              DateTime? @db.Date @map("exited_on")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  createdAt             DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz @map("updated_at")
  deletedAt             DateTime? @db.Timestamptz @map("deleted_at")

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  institution            Institution             @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  facultyProfile         FacultyProfile?
  departmentAppointments DepartmentAppointment[]

  @@unique([institutionId, employeeNumber])
  @@index([institutionId])
  @@index([employmentStatus])
  @@index([employmentType])
  @@map("employee_profiles")
}

model FacultyProfile {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeProfileId   String   @unique @db.Uuid @map("employee_profile_id")
  designation         String
  qualification       String?
  specialization      String?
  weeklyWorkloadHours Decimal  @default(0.0) @db.Decimal(4, 1) @map("weekly_workload_hours")
  leaveBalance        Decimal  @default(0.0) @db.Decimal(4, 1) @map("leave_balance")
  createdAt           DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @db.Timestamptz @map("updated_at")

  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Restrict)

  @@index([designation])
  @@map("faculty_profiles")
}

model DepartmentAppointment {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeProfileId String    @db.Uuid @map("employee_profile_id")
  departmentId      String    @map("department_id")
  campusId          String    @db.Uuid @map("campus_id")
  appointmentRole   String    @default("primary_member") @map("appointment_role")
  startsOn          DateTime  @default(now()) @db.Date @map("starts_on")
  endsOn            DateTime? @db.Date @map("ends_on")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz @map("updated_at")

  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Restrict)
  department      Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  campus          Campus          @relation(fields: [campusId], references: [id], onDelete: Restrict)

  @@index([employeeProfileId])
  @@index([departmentId])
  @@index([campusId])
  @@index([appointmentRole, isActive])
  @@map("department_appointments")
}

model StudentProfile {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @unique @map("user_id")
  institutionId         String    @db.Uuid @map("institution_id")
  studentNumber         String    @map("student_number")
  firstName             String    @map("first_name")
  lastName              String    @map("last_name")
  dateOfBirth           DateTime? @db.Date @map("date_of_birth")
  gender                String?   @default("unspecified")
  bloodGroup            String?   @map("blood_group")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  status                String    @default("active")
  createdAt             DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz @map("updated_at")
  deletedAt             DateTime? @db.Timestamptz @map("deleted_at")

  user               User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  institution        Institution                @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  programEnrollments StudentProgramEnrollment[]

  @@unique([institutionId, studentNumber])
  @@index([institutionId])
  @@index([status])
  @@index([studentNumber])
  @@map("student_profiles")
}

model StudentProgramEnrollment {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentProfileId       String    @db.Uuid @map("student_profile_id")
  programId              String    @db.Uuid @map("program_id")
  institutionId          String    @db.Uuid @map("institution_id")
  entryTermId            String    @db.Uuid @map("entry_term_id")
  admissionApplicationId String?   @map("admission_application_id")
  cohortBatch            String    @map("cohort_batch")
  enrollmentType         String    @default("regular") @map("enrollment_type")
  enrollmentStatus       String    @default("active") @map("enrollment_status")
  enrolledOn             DateTime  @db.Date @map("enrolled_on")
  expectedCompletionDate DateTime? @db.Date @map("expected_completion_date")
  actualCompletionDate   DateTime? @db.Date @map("actual_completion_date")
  createdAt              DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt              DateTime  @default(now()) @updatedAt @db.Timestamptz @map("updated_at")
  deletedAt              DateTime? @db.Timestamptz @map("deleted_at")

  studentProfile       StudentProfile            @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  program              Program                   @relation(fields: [programId], references: [id], onDelete: Restrict)
  institution          Institution               @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  entryTerm            AcademicTerm              @relation(fields: [entryTermId], references: [id], onDelete: Restrict)
  admissionApplication AdmissionApplication?    @relation(fields: [admissionApplicationId], references: [id], onDelete: Restrict)
  termRegistrations    StudentTermRegistration[]

  @@index([studentProfileId])
  @@index([programId])
  @@index([entryTermId])
  @@index([enrollmentStatus])
  @@index([cohortBatch])
  @@map("student_program_enrollments")
}

model StudentTermRegistration {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programEnrollmentId  String    @db.Uuid @map("program_enrollment_id")
  academicTermId       String    @db.Uuid @map("academic_term_id")
  semesterNumber       Int       @map("semester_number")
  section              String?
  registrationStatus   String    @default("draft") @map("registration_status")
  registeredOn         DateTime? @db.Date @map("registered_on")
  completedOn          DateTime? @db.Date @map("completed_on")
  termGpa              Decimal?  @db.Decimal(4, 2) @map("term_gpa")
  cumulativeCgpa       Decimal?  @db.Decimal(4, 2) @map("cumulative_cgpa")
  creditsAttempted     Decimal   @default(0.0) @db.Decimal(4, 1) @map("credits_attempted")
  creditsEarned        Decimal   @default(0.0) @db.Decimal(4, 1) @map("credits_earned")
  attendancePercentage Decimal?  @db.Decimal(5, 2) @map("attendance_percentage")
  academicStanding     String    @default("unspecified") @map("academic_standing")
  notes                String?
  createdAt            DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @db.Timestamptz @map("updated_at")
  deletedAt            DateTime? @db.Timestamptz @map("deleted_at")

  programEnrollment StudentProgramEnrollment @relation(fields: [programEnrollmentId], references: [id], onDelete: Restrict)
  academicTerm      AcademicTerm             @relation(fields: [academicTermId], references: [id], onDelete: Restrict)

  @@unique([programEnrollmentId, academicTermId])
  @@index([programEnrollmentId])
  @@index([academicTermId])
  @@index([registrationStatus])
  @@index([academicTermId, semesterNumber, section])
  @@map("student_term_registrations")
}

model ExaminerAssignment {
  id            String      @id @default(uuid())
  examinerId    String      @map("examiner_id")
  examinationId String      @map("examination_id")
  courseId      String      @map("course_id")
  assignedAt    DateTime    @default(now()) @map("assigned_at")
  status        String      @default("assigned")

  examiner    User        @relation(fields: [examinerId], references: [id], onDelete: Cascade)
  examination Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([examinerId, examinationId, courseId])
  @@index([examinerId])
  @@index([examinationId])
  @@index([courseId])
  @@map("examiner_assignments")
}

model InstitutionHodAssignment {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionId String    @db.Uuid @map("institution_id")
  userId        String    @map("user_id")
  appointedAt   DateTime  @default(now()) @db.Timestamptz @map("appointed_at")
  relievedAt    DateTime? @db.Timestamptz @map("relieved_at")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([institutionId])
  @@index([userId])
  @@index([isActive])
  @@map("institution_hod_assignments")
}
